# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-production-jwt-secret-key-at-least-32-characters
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobhunter_db?schema=public"

# Redis & BullMQ Queue Processing
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration (openai | anthropic | local)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LOCAL_LLM_URL=http://localhost:11434

# Recruiter Search Providers
HUNTER_API_KEY=your-hunter-io-api-key-here
APOLLO_API_KEY=your-apollo-io-api-key-here

# Email OAuth & Encryption (Google OAuth 2.0 & Microsoft Graph)
ENCRYPTION_SECRET=your-token-encryption-secret-key-32-chars-long!!

GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:5000/api/email/oauth/gmail/callback

MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/email/oauth/outlook/callback
MICROSOFT_TENANT_ID=common
