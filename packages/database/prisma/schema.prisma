datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

enum MatchPriority {
  APPLY_NOW
  STRONG_MATCH
  POSSIBLE
  LOW_MATCH
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  APPLIED
  RECRUITER_CONTACTED
  RECRUITER_RESPONDED
  INTERVIEW_SCHEDULED
  TECHNICAL_ROUND
  HR_ROUND
  OFFER
  REJECTED
  WITHDRAWN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum EmailClassification {
  RECRUITER
  INTERVIEW
  REJECTION
  CONFIRMATION
  ASSESSMENT
  OFFER
  SPAM
  OTHER
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String?
  googleId         String?           @unique
  name             String
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  profile          CandidateProfile?
  resumes          Resume[]
  searchProfiles   SearchProfile[]
  jobAlerts        JobAlert[]
  companyWatches   CompanyWatch[]
  applications     Application[]
  emailAccounts    EmailAccount[]
  emailCampaigns   EmailCampaign[]
  activities       ActivityLog[]

  @@index([email])
}

model CandidateProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  location           String?
  preferredLocations String[]
  remotePref         RemotePreference @default(ANY)
  experienceYears    Float            @default(0)
  currentRole        String?
  targetRoles        String[]
  salaryMin          Int?
  salaryMax          Int?
  noticePeriodDays   Int?             @default(30)
  education          Json?
  certifications     String[]
  githubUrl          String?
  portfolioUrl       String?
  linkedinUrl        String?
  naukriUrl          String?
  skills             CandidateSkill[]
  projects           Json?
  workExperience     Json?
  aiProfileAnalysis  Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  category   String?
  candidates CandidateSkill[]
}

model CandidateSkill {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id])
  yearsExperience    Float            @default(0)
  proficiencyLevel   String           @default("INTERMEDIATE")

  @@unique([candidateProfileId, skillId])
}

model Resume {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String
  rawText     String?
  parsedData  Json?
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  applications Application[]

  @@index([userId])
}

model JobSource {
  id          String   @id @default(uuid())
  name        String   @unique
  enabled     Boolean  @default(true)
  config      Json?
  jobs        Job[]
}

model Company {
  id           String         @id @default(uuid())
  name         String
  website      String?
  logoUrl      String?
  industry     String?
  size         String?
  headquarters String?
  knownAts     String?
  techStack    String[]
  jobs         Job[]
  recruiters   Recruiter[]
  watches      CompanyWatch[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
}

model Job {
  id              String           @id @default(uuid())
  title           String
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  sourceId        String
  source          JobSource        @relation(fields: [sourceId], references: [id])
  externalId      String?
  canonicalUrl    String           @unique
  applicationUrl  String
  location        String
  remoteType      RemotePreference @default(ANY)
  salaryMin       Int?
  salaryMax       Int?
  experienceMin   Float?
  experienceMax   Float?
  description     String
  requiredSkills  String[]
  preferredSkills String[]
  employmentType  String?
  postedAt        DateTime         @default(now())
  isActive        Boolean          @default(true)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  matches         JobMatch[]
  applications    Application[]
  recruiters      JobRecruiter[]

  @@index([title])
  @@index([companyId])
  @@index([location])
  @@index([postedAt])
  @@index([canonicalUrl])
}

model Recruiter {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  name           String
  role           String
  linkedinUrl    String?
  email          String?
  isVerified     Boolean        @default(false)
  confidence     Float          @default(0.5)
  source         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  jobRecruiters  JobRecruiter[]
  emailMessages  EmailMessage[]

  @@index([companyId])
}

model JobRecruiter {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId String
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  relevance   Float     @default(0.8)

  @@unique([jobId, recruiterId])
}

model JobMatch {
  id                  String        @id @default(uuid())
  userId              String
  jobId               String
  job                 Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore        Float
  priority            MatchPriority
  skillMatch          Float
  experienceMatch     Float
  roleMatch           Float
  locationMatch       Float
  salaryMatch         Float
  educationMatch      Float
  resumeKeywordMatch  Float
  projectMatch        Float
  whyApply            String[]
  whatHoldsBack       String[]
  recommendedResumeId String?
  calculatedAt        DateTime      @default(now())

  @@unique([userId, jobId])
  @@index([userId, overallScore])
  @@index([priority])
}

model Application {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id])
  resumeId       String?
  resume         Resume?           @relation(fields: [resumeId], references: [id])
  status         ApplicationStatus @default(DISCOVERED)
  appliedAt      DateTime?
  qualityScore   Float?
  notes          String?
  customAnswers  Json?
  coverLetter    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  events         ApplicationEvent[]
  followUps      FollowUp[]
  interviews     Interview[]
  emailMessages  EmailMessage[]

  @@unique([userId, jobId])
  @@index([userId, status])
}

model ApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  createdAt     DateTime          @default(now())
}

model EmailAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  emailAddress String
  accessToken  String?
  refreshToken String?
  smtpHost     String?
  smtpPort     Int?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  messages     EmailMessage[]
}

model EmailCampaign {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus @default(ACTIVE)
  dailyLimit  Int            @default(10)
  createdAt   DateTime       @default(now())

  messages    EmailMessage[]
}

model EmailMessage {
  id             String               @id @default(uuid())
  campaignId     String?
  campaign       EmailCampaign?       @relation(fields: [campaignId], references: [id])
  accountId      String
  account        EmailAccount         @relation(fields: [accountId], references: [id])
  recruiterId    String?
  recruiter      Recruiter?           @relation(fields: [recruiterId], references: [id])
  applicationId  String?
  application    Application?         @relation(fields: [applicationId], references: [id])
  subject        String
  body           String
  isApproved     Boolean              @default(false)
  approvedAt     DateTime?
  sentAt         DateTime?
  classification EmailClassification?
  aiReasoning    String?
  createdAt      DateTime             @default(now())
}

model FollowUp {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledFor  DateTime
  completedAt   DateTime?
  stepNumber    Int         @default(1)
  suggestedBody String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([scheduledFor, completedAt])
}

model Interview {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundName     String
  scheduledAt   DateTime
  locationUrl   String?
  interviewer   String?
  prepNotes     Json?
  feedback      String?
  status        String   @default("SCHEDULED")
  createdAt     DateTime @default(now())

  questions     InterviewQuestion[]
}

model InterviewQuestion {
  id              String    @id @default(uuid())
  interviewId     String
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  category        String
  question        String
  suggestedAnswer String
}

model SearchProfile {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetRoles String[]
  locations   String[]
  remotePref  RemotePreference @default(ANY)
  minSalary   Int?
  maxSalary   Int?
  skills      String[]
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model JobAlert {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  criteria   Json
  frequency  String    @default("DAILY")
  isActive   Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
}

model CompanyWatch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
