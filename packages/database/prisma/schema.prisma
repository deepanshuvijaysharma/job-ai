datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

enum MatchPriority {
  APPLY_NOW
  STRONG_MATCH
  POSSIBLE
  LOW_MATCH
}

enum ApplicationStatus {
  DISCOVERED
  SHORTLISTED
  APPLIED
  RECRUITER_CONTACTED
  RECRUITER_RESPONDED
  INTERVIEW_SCHEDULED
  TECHNICAL_ROUND
  HR_ROUND
  OFFER
  REJECTED
  WITHDRAWN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum EmailClassification {
  RECRUITER
  INTERVIEW
  REJECTION
  CONFIRMATION
  ASSESSMENT
  OFFER
  SPAM
  OTHER
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String?
  googleId         String?           @unique
  name             String
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  profile          CandidateProfile?
  resumes          Resume[]
  searchProfiles   SearchProfile[]
  jobAlerts        JobAlert[]
  companyWatches   CompanyWatch[]
  applications     Application[]
  emailAccounts    EmailAccount[]
  emailCampaigns   EmailCampaign[]
  activities       ActivityLog[]

  @@index([email])
}

model CandidateProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  location           String?
  preferredLocations String[]
  remotePref         RemotePreference @default(ANY)
  experienceYears    Float            @default(0)
  currentRole        String?
  targetRoles        String[]
  salaryMin          Int?
  salaryMax          Int?
  noticePeriodDays   Int?             @default(30)
  education          Json?
  certifications     String[]
  githubUrl          String?
  portfolioUrl       String?
  linkedinUrl        String?
  naukriUrl          String?
  skills             CandidateSkill[]
  projects           Json?
  workExperience     Json?
  aiProfileAnalysis  Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Skill {
  id         String           @id @default(uuid())
  name       String           @unique
  category   String?
  candidates CandidateSkill[]
}

model CandidateSkill {
  id                 String           @id @default(uuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id])
  yearsExperience    Float            @default(0)
  proficiencyLevel   String           @default("INTERMEDIATE")

  @@unique([candidateProfileId, skillId])
}

model Resume {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String
  rawText     String?
  parsedData  Json?
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  applications Application[]

  @@index([userId])
}

model JobSource {
  id                  String    @id @default(uuid())
  name                String    @unique
  type                String    @default("PUBLIC_FEED")
  enabled             Boolean   @default(true)
  config              Json?
  lastAttempt         DateTime?
  lastSuccess         DateTime?
  lastError           DateTime?
  lastErrorMessage    String?
  consecutiveFailures Int       @default(0)
  jobs                Job[]
}

model Company {
  id           String         @id @default(uuid())
  name         String
  website      String?
  logoUrl      String?
  industry     String?
  size         String?
  headquarters String?
  knownAts     String?
  techStack    String[]
  jobs         Job[]
  recruiters   Recruiter[]
  watches      CompanyWatch[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
}

model Job {
  id              String           @id @default(uuid())
  title           String
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  sourceId        String
  source          JobSource        @relation(fields: [sourceId], references: [id])
  externalId      String?
  canonicalUrl    String           @unique
  applicationUrl  String
  location        String
  remoteType      RemotePreference @default(ANY)
  salaryMin       Int?
  salaryMax       Int?
  experienceMin   Float?
  experienceMax   Float?
  description     String
  requiredSkills  String[]
  preferredSkills String[]
  employmentType  String?
  postedAt        DateTime         @default(now())
  isActive        Boolean          @default(true)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  matches         JobMatch[]
  applications    Application[]
  recruiters      JobRecruiter[]

  @@index([title])
  @@index([companyId])
  @@index([location])
  @@index([postedAt])
  @@index([canonicalUrl])
}

model Recruiter {
  id                 String         @id @default(uuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  name               String
  role               String
  linkedinUrl        String?
  email              String?
  emailSource        String?
  emailVerified      String         @default("UNKNOWN") // VERIFIED | PUBLIC | UNVERIFIED | UNKNOWN
  profileSource      String?
  sourceUrl          String?
  location           String?
  department         String?
  recruitingFocus    String?
  verificationStatus String         @default("UNVERIFIED") // VERIFIED | PUBLIC | UNVERIFIED | NO_CONTACT
  isVerified         Boolean        @default(false)
  confidence         Float          @default(0.5)
  source             String?
  lastVerifiedAt     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  jobRecruiters  JobRecruiter[]
  emailMessages  EmailMessage[]
  followUps      FollowUp[]

  @@index([companyId])
}

model JobRecruiter {
  id              String    @id @default(uuid())
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterId     String
  recruiter       Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  relevance       Float     @default(0.8)
  relevanceScore  Float     @default(70.0)
  relevanceReason String[]
  evidence        Json?
  lastVerifiedAt  DateTime?

  @@unique([jobId, recruiterId])
}

model JobMatch {
  id                  String        @id @default(uuid())
  userId              String
  jobId               String
  job                 Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore        Float
  priority            MatchPriority
  skillMatch          Float
  experienceMatch     Float
  roleMatch           Float
  locationMatch       Float
  salaryMatch         Float
  educationMatch      Float
  resumeKeywordMatch  Float
  projectMatch        Float
  whyApply            String[]
  whatHoldsBack       String[]
  recommendedResumeId String?
  calculatedAt        DateTime      @default(now())

  @@unique([userId, jobId])
  @@index([userId, overallScore])
  @@index([priority])
}

model Application {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id])
  resumeId       String?
  resume         Resume?           @relation(fields: [resumeId], references: [id])
  status         ApplicationStatus @default(DISCOVERED)
  appliedAt      DateTime?
  qualityScore   Float?
  notes          String?
  customAnswers  Json?
  coverLetter    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  events         ApplicationEvent[]
  followUps      FollowUp[]
  interviews     Interview[]
  emailMessages  EmailMessage[]

  @@unique([userId, jobId])
  @@index([userId, status])
}

model ApplicationEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  createdAt     DateTime          @default(now())
}

model EmailAccount {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  emailAddress          String
  accessToken           String?
  refreshToken          String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  smtpHost              String?
  smtpPort              Int?
  isDefault             Boolean  @default(false)
  isConnected           Boolean  @default(true)
  lastTestedAt          DateTime?
  dailySentCount        Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  messages     EmailMessage[]
}

model EmailCampaign {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      CampaignStatus @default(ACTIVE)
  dailyLimit  Int            @default(10)
  createdAt   DateTime       @default(now())

  messages    EmailMessage[]
}

model EmailMessage {
  id                String               @id @default(uuid())
  campaignId        String?
  campaign          EmailCampaign?       @relation(fields: [campaignId], references: [id])
  accountId         String
  account           EmailAccount         @relation(fields: [accountId], references: [id])
  recruiterId       String?
  recruiter         Recruiter?           @relation(fields: [recruiterId], references: [id])
  applicationId     String?
  application       Application?         @relation(fields: [applicationId], references: [id])
  subject           String
  body              String
  isApproved        Boolean              @default(false)
  approvedAt        DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  status            String               @default("PENDING")
  externalMessageId String?
  failureReason     String?
  classification    EmailClassification?
  aiReasoning       String?
  createdAt         DateTime             @default(now())
}

model FollowUp {
  id               String      @id @default(uuid())
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiterId      String?
  recruiter        Recruiter?  @relation(fields: [recruiterId], references: [id])
  userId           String?
  stepNumber       Int         @default(1)
  scheduledAt      DateTime
  status           String      @default("SCHEDULED")
  suggestedSubject String?
  suggestedBody    String?
  sourceMessageId  String?
  approvedAt       DateTime?
  sentAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  failureReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([applicationId, stepNumber])
  @@index([scheduledAt, status])
}

model Interview {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundName     String
  scheduledAt   DateTime
  locationUrl   String?
  interviewer   String?
  prepNotes     Json?
  feedback      String?
  status        String   @default("SCHEDULED")
  createdAt     DateTime @default(now())

  questions     InterviewQuestion[]
}

model InterviewQuestion {
  id              String    @id @default(uuid())
  interviewId     String
  interview       Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  category        String
  question        String
  suggestedAnswer String
}

model SearchProfile {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetRoles String[]
  locations   String[]
  remotePref  RemotePreference @default(ANY)
  minSalary   Int?
  maxSalary   Int?
  skills      String[]
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model JobAlert {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  criteria   Json
  frequency  String    @default("DAILY")
  isActive   Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
}

model CompanyWatch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CompanyWatchlist {
  id                    String    @id @default(uuid())
  company               String
  careerUrl             String?
  atsType               String    @default("CAREER_PAGE") // CAREER_PAGE | GREENHOUSE | LEVER | PUBLIC_FEED
  boardToken            String?   // Greenhouse board token or Lever company identifier
  enabled               Boolean   @default(true)
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  lastErrorAt           DateTime?
  lastErrorMessage      String?
  consecutiveFailures   Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([atsType])
  @@index([enabled])
}
